# Copy to .env (gitignored); wrangler picks it up automatically.
# Token: dash.cloudflare.com/profile/api-tokens -> Create Token ->
# "Edit Cloudflare Workers" template, then ADD two permissions the
# template predates: Account -> Workers R2 Storage -> Edit (bucket
# create) and Account -> Containers -> Edit (without it, deploy 401s on
# the containers step). User token, not Account API token: account
# tokens lack the User->Memberships->Read scope wrangler may call.
# NOTE it is account-wide over Workers, registry included: mint fresh
# for this project, revoke when the experiment ends.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
