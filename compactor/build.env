# Pinned inputs of compactor/build.sh. The image digest is a function of
# these, contain.yaml's base, go.mod/go.sum and the source.

# Go and the C toolchain (Debian trixie gcc) that links the engine:
# golang:1.27.1-trixie@sha256:433790e515d27dc6003e847e644cc0af956985cf315c1c58a3b73ee2dd305183
# pinned by its per-platform manifests, because Docker's classic image
# store keeps one platform per reference, and an index reference pulled
# for one arch then refuses to run the other
BUILDER=golang:1.27.1-trixie
BUILDER_linux_amd64=golang:1.27.1-trixie@sha256:7bffdb405cd12940d2980daa49a86ef575ed4525a17ee7d0c9562547357ab46a
BUILDER_linux_arm64=golang:1.27.1-trixie@sha256:9fef6c185fa8277ea98a09c2067351103b002cce3a421771dceb241c25a22529
# run in the builder with go run, sumdb-verified
CONTAIN=v1.1.0
CRANE=v0.22.1
# qemu for building the foreign arch (build.sh host-setup)
BINFMT=tonistiigi/binfmt:qemu-v10.2.3@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0

RELEASE_PLATFORMS=linux/amd64,linux/arm64
IMAGE_REPO=ghcr.io/yolean/blobs-compactor

# must be the engine that go.sum pins (duckdb-go-bindings v0.10505.0);
# selftest fails on a mismatch because LOAD checks the version
DUCKDB_VERSION=v1.5.5
HTTPFS_SHA256_linux_amd64=7cdd52a3135388718884a9b71e3987ba723002121e8e9de399c4ed619d824a05
HTTPFS_SHA256_linux_arm64=0820e0b5b74efaa23608c239df8e744a68943318d530b483a529eace19cb5475
