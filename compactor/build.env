# Pinned inputs of compactor/build.sh. The image digest is a function of
# these, contain.yaml's base, go.mod/go.sum and the source.

# Go and the C toolchain (Debian trixie gcc) that links the engine:
# golang:1.27.3-trixie@sha256:2336eda24930976591abea806d9b7d99eeae38238f19755c5deec02facdc1594
# pinned by its per-platform manifests, because Docker's classic image
# store keeps one platform per reference, and an index reference pulled
# for one arch then refuses to run the other
BUILDER=golang:1.27.3-trixie
BUILDER_linux_amd64=golang:1.27.3-trixie@sha256:a5406f41680f17b4aa0b49de641e00f116215f5c8829d548d29cb44c4f85aa4f
BUILDER_linux_arm64=golang:1.27.3-trixie@sha256:4f03804fe5085b5e565347663bc51a54177634097cc71e9f816af6c2672f7662
# run in the builder with go run, sumdb-verified
CONTAIN=v1.1.0
CRANE=v0.22.1
# qemu for building the foreign arch (build.sh host-setup)
BINFMT=tonistiigi/binfmt:qemu-v10.2.3@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0

RELEASE_PLATFORMS=linux/amd64,linux/arm64
IMAGE_REPO=ghcr.io/yolean/observability-state

# must be the engine that go.sum pins (duckdb-go-bindings v0.10506.0);
# selftest fails on a mismatch because LOAD checks the version
DUCKDB_VERSION=v1.5.6
HTTPFS_SHA256_linux_amd64=19e6906934a845487c96f9c94beee250c71e32bb9be260eb27ad96939a1df5f0
HTTPFS_SHA256_linux_arm64=b18472a0e85cbf15ca4ebbe335173f87b62a074cd0f26072d4c756205c6239d0
