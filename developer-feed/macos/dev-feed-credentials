#!/bin/sh
# The bucket credential of the user-level host agent, in the login Keychain
# (developer-feed/macos/README.md, Credential); never in a file:
#
#   dev-feed-credentials          print it: fluent-bit's credential_process
#   dev-feed-credentials store    keep the credential_process JSON read from
#                                 stdin, from dev-feed-r2 mint, and write its
#                                 expiry, which is not secret, to the config
#   dev-feed-credentials expiry   print its Expiration
#
# The JSON is kept base64-encoded as the password of a generic password
# item, service observability-host-v1, account the user. store hands it to
# `security -i` on stdin, so it is never in a command line (ps). Interim: an
# item that `security` made can be read by any process of the user that runs
# `security`; a helper is to own the item instead, so that any other reader
# causes a dialog.
set -eu
prefix=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib/config.sh
. "$prefix/lib/config.sh"
service=observability-host-v1
account=$(id -un)

case "${1:-}" in
  "")
    # each step's failure is the command's: a pipe would hide the lookup's
    b64=$(security find-generic-password -s "$service" -a "$account" -w 2>/dev/null) \
      || { echo "dev-feed-credentials: no item $service for $account in the login Keychain" >&2; exit 1; }
    printf '%s' "$b64" | base64 -D
    ;;
  store)
    json=$(cat)
    case "$json" in
      *'"Version":1'*'"SessionToken"'*) ;;
      *) echo "dev-feed-credentials: stdin is not dev-feed-r2 mint's credential_process JSON" >&2; exit 2;;
    esac
    b64=$(printf '%s' "$json" | base64 | tr -d '\n')
    printf 'add-generic-password -U -s %s -a %s -l %s -w %s\n' "$service" "$account" "$service-bucket-credential" "$b64" | security -i >/dev/null
    # security -i reports a failed command in its output, not its status:
    # read the item back
    expiration=$(printf '%s' "$json" | sed -n 's/.*"Expiration":"\([^"]*\)".*/\1/p')
    [ "$("$0" expiry 2>/dev/null)" = "$expiration" ] \
      || { echo "dev-feed-credentials: the credential did not read back from the login Keychain" >&2; exit 1; }
    echo "credential: stored in the login Keychain, service $service, account $account" >&2
    cfg_set DEV_FEED_CREDENTIAL_EXPIRATION "$expiration"
    ;;
  expiry)
    json=$("$0") || exit 1
    printf '%s' "$json" | sed -n 's/.*"Expiration":"\([^"]*\)".*/\1/p'
    ;;
  *)
    echo "usage: dev-feed-credentials [store|expiry]" >&2
    exit 2
    ;;
esac
