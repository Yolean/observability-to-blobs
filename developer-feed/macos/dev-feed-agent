#!/bin/sh
# What launchd runs (com.yolean.observability-host, developer-feed/macos/
# README.md): the host agent's launcher with the user-level layout and the
# settings in the config's env, which install.sh and setup-bucket.sh keep.
# No secrets come from there: the bucket credential is fluent-bit's
# credential_process (dev-feed-credentials), from the login Keychain.
set -eu
prefix=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib/config.sh
. "$prefix/lib/config.sh"

set -a
# shellcheck disable=SC1090 # the config's env
. "$cfg_file"
set +a
for v in CLUSTER_NAME NODE_NAME S3_BUCKET S3_ENDPOINT; do
  eval "[ -n \"\${$v:-}\" ]" || { echo "dev-feed-agent: $v is not set in $cfg_file (developer-feed/macos/install.sh)" >&2; exit 2; }
done

export STATE_DIRECTORY="$OBSERVABILITY_HOST_STATE"
export HOST_ETC="$prefix/etc/host"
export HOST_ARGS_FILE="$OBSERVABILITY_HOST_CONFIG/args"
export HOST_COLLECTOR_DIRS="$prefix/etc/developer-feed"
export HEARTBEAT_COMMAND="$prefix/bin/observability-host-heartbeat"
export PATH="$prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# the credential: credential_process in this file, and no shared
# credentials file to fall back on
export AWS_CONFIG_FILE="$OBSERVABILITY_HOST_CONFIG/aws-config"
export AWS_SHARED_CREDENTIALS_FILE="$OBSERVABILITY_HOST_CONFIG/no-shared-credentials"
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE

exec "$prefix/bin/observability-host-launch" "$@"
