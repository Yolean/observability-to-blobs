# Copy to .env.r2 (gitignored) and fill in an R2 *Account* API token
# (dashboard: R2 -> Manage API tokens), permission Object Read & Write,
# scoped to ONLY the node-agent-itest bucket so it cannot touch
# other buckets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# the account's EU-jurisdiction endpoint, https://<account id>.eu.r2.cloudflarestorage.com
S3_ENDPOINT=
