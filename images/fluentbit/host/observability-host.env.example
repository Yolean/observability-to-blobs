# /etc/observability-host/env, read by observability-host.service.
# The bucket key is not here: it is /etc/observability-host/s3-credentials.
# Defaults and the remaining settings: etc/host.yaml.
# required, with no default: the cluster's name, as its node agents have it,
# the bucket, and its endpoint with the scheme, e.g. https://s3.example.com
# (the unit does not start without all three)
CLUSTER_NAME=
S3_BUCKET=
S3_ENDPOINT=
# default: the host name
#NODE_NAME=host-a
#S3_REGION=us-east-1
#S3_TLS=on
# the first segment of every object key
#KEY_ROOT=host1
#UPLOAD_TIMEOUT=30s
# more files to tail, comma-separated paths or globs
#HOST_EXTRA_FILES=/var/log/kubernetes/audit.log
# journal rows whose unit matches this regular expression are left out
#HOST_JOURNAL_DENY=^(noisy\.service|chatty\.service)$
# on a Kubernetes node the DaemonSet exports node_*: serve only the restart flag
#HOST_NODE_COLLECTORS=textfile
#HOST_METRICS_LISTEN=127.0.0.1
#HOST_METRICS_PORT=2023
#HOST_BUFFER_LIMIT=4G
# the CA bundle the S3 output trusts
#HOST_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
#HOST_LOG_LEVEL=info
# more directories of collectors, colon-separated; the machine's own are
# in /etc/observability-host/collectors/ (HOST_MODE.md, Your own collectors)
#HOST_COLLECTOR_DIRS=/opt/more-collectors
